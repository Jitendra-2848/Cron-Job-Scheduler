# Server Configuration
PORT=8000
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cronMaster

# Cache & Task Queue (Redis)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=your_high_entropy_jwt_secret_here

# Frontend URL (For CORS & Cookie Security)
FRONTEND_URL=https://your-app.vercel.app

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/auth/google/callback
CLIENT_REDIRECT_URL=https://your-app.vercel.app/dashboard
